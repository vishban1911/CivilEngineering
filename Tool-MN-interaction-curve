generateCombos();
updateSketch();

function steelStress(strainAbs, fy){
  if (strainAbs <= 0) return 0;
  if (fy === 250){
    const fd = 0.87*250;
    const e1 = fd/Es;
    return strainAbs >= e1 ? fd : strainAbs*Es;
  }
  const fd = 0.87*fy;
  const e1 = 0.8*fd/Es;
  const pts = [
    [e1, 0.8*fd],
    [e1+0.0001, 0.85*fd],
    [e1+0.0003, 0.90*fd],
    [e1+0.0007, 0.95*fd],
    [e1+0.0010, 0.975*fd],
    [e1+0.0020, 1.0*fd]
  ];
  if (strainAbs <= pts[0][0]) return strainAbs*Es;
  if (strainAbs >= pts[5][0]) return fd;
  for (let i=0;i<5;i++){
    const p1 = pts[i], p2 = pts[i+1];
    if (strainAbs >= p1[0] && strainAbs <= p2[0]){
      const t = (strainAbs-p1[0])/(p2[0]-p1[0]);
      return p1[1] + t*(p2[1]-p1[1]);
    }
  }
  return fd;
}

function concreteStress(strain, fck){
  if (strain <= 0) return 0;
  const e = Math.min(strain, 0.0035);
  if (e <= 0.002){
    const r = e/0.002;
    return 0.447*fck*(2*r - r*r);
  }
  return 0.447*fck;
}

function computeBranch(layers, b, D, fck, fy, N){
  N = N || 300;
  const nPts = 150;
  const pts = [];
  const dy = D/N;
  for(let i=0;i<nPts;i++){
    const k = 0.02 + i*(4.0-0.02)/(nPts-1);
    const xu = k*D;
    let ecTop;
    if (k >= 1) ecTop = 0.002/(1 - (3*D)/(7*xu));
    else ecTop = 0.0035;

    let Pc = 0, Mc = 0;
    for (let s=0;s<N;s++){
      const y = (s+0.5)*dy;
      const strain = ecTop*(1 - y/xu);
      const fc = concreteStress(strain, fck);
      if (fc > 0){
        const force = fc*b*dy;
        Pc += force;
        Mc += force*(D/2 - y);
      }
    }
    let Ps = 0, Ms = 0;
    for (const layer of layers){
      const y = layer.yFromTop;
      const strain = ecTop*(1 - y/xu);
      const mag = steelStress(Math.abs(strain), fy);
      const fs = Math.sign(strain)*mag;
      let fcDisp = 0;
      if (strain > 0) fcDisp = concreteStress(strain, fck);
      const force = (fs - fcDisp)*layer.As;
      Ps += force;
      Ms += force*(D/2 - y);
    }
    pts.push({k, xu, Pu:(Pc+Ps)/1000, Mu:(Mc+Ms)/1e6});
  }
  return pts;
}

function barArea(dia,n){ return n*Math.PI/4*dia*dia; }

function findMcapacity(branch, PuTarget){
  const Pus = branch.map(p=>p.Pu);
  const maxIdx = Pus.indexOf(Math.max(...Pus));
  if (PuTarget > Pus[maxIdx]) return {exceeds:true};
  if (PuTarget < Math.min(...Pus)) return {exceeds:true, tension:true};
  for (let i=0;i<branch.length-1;i++){
    const a = branch[i], c = branch[i+1];
    if ((a.Pu - PuTarget)*(c.Pu - PuTarget) <= 0 && a.Pu !== c.Pu){
      const t = (PuTarget - a.Pu)/(c.Pu - a.Pu);
      return {exceeds:false, Mu: a.Mu + t*(c.Mu-a.Mu), xu: a.xu + t*(c.xu-a.xu)};
    }
  }
  let bestp = branch[0], bd = Math.abs(branch[0].Pu-PuTarget);
  for (const p of branch){ const d=Math.abs(p.Pu-PuTarget); if (d<bd){bd=d;bestp=p;} }
  return {exceeds:false, Mu:bestp.Mu, xu:bestp.xu};
}

// Combined P-M utilisation: scale (Pd,Md) radially from the origin until it meets the capacity envelope.
function findUtilization(branch, Pd, Md){
  if (Pd===0 && Md===0) return {utilization:0, xu:null};
  let best = null;
  for (let i=0;i<branch.length-1;i++){
    const A = branch[i], B = branch[i+1];
    const ex = B.Pu-A.Pu, ey = B.Mu-A.Mu;
    const det = -Pd*ey + ex*Md;
    if (Math.abs(det) < 1e-9) continue;
    const t = (-A.Pu*ey + ex*A.Mu)/det;
    const s = (Pd*A.Mu - Md*A.Pu)/det;
    if (t>1e-9 && s>=-1e-6 && s<=1+1e-6){
      if (best===null || t<best.t){
        best = {t, xu: A.xu + Math.max(0,Math.min(1,s))*(B.xu-A.xu)};
      }
    }
  }
  if (best===null) return {utilization:null, xu:null, exceeds:true};
  return {utilization: 1/best.t, xu: best.xu};
}

function fmt(n, d){ if (n===null||n===undefined||isNaN(n)) return '—'; return n.toFixed(d===undefined?1:d); }

function getFy(){
  const v = document.getElementById('fy').value;
  return v==='500d' ? 500 : parseFloat(v);
}

function collectLayers(D){
  const t1 = {As: barArea(parseFloat(document.getElementById('t1dia').value)||0, parseFloat(document.getElementById('t1n').value)||0), yFromTop: parseFloat(document.getElementById('t1cov').value)||0};
  const b1c = parseFloat(document.getElementById('b1cov').value)||0;
  const b1 = {As: barArea(parseFloat(document.getElementById('b1dia').value)||0, parseFloat(document.getElementById('b1n').value)||0), yFromTop: D-b1c};
  const layers = [t1,b1];
  if (document.getElementById('t2en').checked){
    layers.push({As: barArea(parseFloat(document.getElementById('t2dia').value)||0, parseFloat(document.getElementById('t2n').value)||0), yFromTop: parseFloat(document.getElementById('t2cov').value)||0});
  }
  if (document.getElementById('b2en').checked){
    const b2c = parseFloat(document.getElementById('b2cov').value)||0;
    layers.push({As: barArea(parseFloat(document.getElementById('b2dia').value)||0, parseFloat(document.getElementById('b2n').value)||0), yFromTop: D-b2c});
  }
  return layers.filter(l=>l.As>0);
}

function stat(label, val, sub, highlight){
  return '<div class="stat'+(highlight?' highlight':'')+'"><div class="stat-label">'+label+'</div><div class="stat-val">'+val+'</div><div class="stat-sub">'+sub+'</div></div>';
}

let LAST = null; // cache for chart re-draw

function runCalc(){
  const b = parseFloat(document.getElementById('b').value);
  const D = parseFloat(document.getElementById('D').value);
  const fck = parseFloat(document.getElementById('fck').value);
  const fy = getFy();

  const allLayers = collectLayers(D);
  if (allLayers.length===0){ alert('Enter at least one reinforcement layer.'); return; }

  const branchA = computeBranch(allLayers, b, D, fck, fy);
  const mirrored = allLayers.map(l=>({As:l.As, yFromTop: D-l.yFromTop}));
  const branchBraw = computeBranch(mirrored, b, D, fck, fy);
  const branchB = branchBraw.map(p=>({k:p.k, xu:p.xu, Pu:p.Pu, Mu:-p.Mu}));

  const Asc = allLayers.reduce((s,l)=>s+l.As,0);
  const Ac = b*D - Asc;
  const PuMaxCode = (0.4*fck*Ac + 0.67*fy*Asc)/1000;

  const branchAc = branchA.map(p=>({...p, Pu:Math.min(p.Pu, PuMaxCode)}));
  const branchBc = branchB.map(p=>({...p, Pu:Math.min(p.Pu, PuMaxCode)}));

  const muAtPu0_A = findMcapacity(branchAc, 0);
  const muAtPu0_B = findMcapacity(branchBc, 0);
  let balanced = branchAc[0];
  for (const p of branchAc) if (p.Mu > balanced.Mu) balanced = p;

  const steelPct = (100*Asc/(b*D));
  document.getElementById('steelSummary').innerHTML =
    'Total reinforcement area A<sub>sc</sub> = '+fmt(Asc,0)+' mm² &nbsp;(p = '+fmt(steelPct,2)+'% of gross area). Layers used: '+allLayers.length+'.';

  // gather all combos/cases from the consolidated table
  const combos = [];
  let current = null;
  document.querySelectorAll('#combosBody tr').forEach(tr=>{
    if (tr.classList.contains('combo-name-row')){
      const name = tr.querySelector('.combo-name').value || 'Combination';
      current = {name, cases:[]};
      combos.push(current);
    } else if (tr.classList.contains('case-row') && current){
      const ci = parseInt(tr.getAttribute('data-case'));
      const Pval = parseFloat(tr.querySelector('.pu-input').value);
      const Mval = parseFloat(tr.querySelector('.mu-input').value);
      if (!isNaN(Pval) && !isNaN(Mval)){
        current.cases.push({label:CASE_LABELS[ci], Pu:Pval, Mu:Mval});
      }
    }
  });
  const combosNonEmpty = combos.filter(c=>c.cases.length>0);
  combos.length = 0;
  combos.push(...combosNonEmpty);

  if (combos.length===0){ alert('Enter at least one load case (Pu and Mu) in a load combination.'); return; }

  // compute utilisation for every case
  let governing = null;
  combos.forEach(combo=>{
    combo.cases.forEach(c=>{
      const branch = c.Mu >= 0 ? branchAc : branchBc;
      const res = findUtilization(branch, c.Pu, c.Mu);
      c.util = res.utilization;
      c.xu = res.xu;
      c.exceeds = res.exceeds || false;
      const u = c.exceeds ? Infinity : c.util;
      if (governing===null || u > governing.u){
        governing = {u, label: combo.name+' — '+c.label, Pu:c.Pu, Mu:c.Mu};
      }
    });
  });

  const summary = document.getElementById('summaryGrid');
  summary.innerHTML =
    stat('P_{u,max} (Cl 39.3)', fmt(PuMaxCode,0)+' kN', 'Pure axial capacity cap') +
    stat('M_u at P_u = 0 (+M)', fmt(muAtPu0_A.Mu,1)+' kNm', 'Pure bending, top in tension') +
    stat('M_u at P_u = 0 (−M)', fmt(-muAtPu0_B.Mu,1)+' kNm', 'Pure bending, bottom in tension') +
    stat('Governing utilisation', (isFinite(governing.u)?fmt(100*governing.u,0)+'%':'> 100%'), governing.label, true);

  LAST = {branchAc, branchBc, PuMaxCode, combos};
  drawChart(LAST);

  const vbody = document.getElementById('verifyBody');
  vbody.innerHTML = '';
  combos.forEach(combo=>{
    const head = document.createElement('tr');
    head.className = 'group-head';
    head.innerHTML = '<td colspan="6">'+combo.name+'</td>';
    vbody.appendChild(head);
    combo.cases.forEach(c=>{
      const isGov = governing && (combo.name+' — '+c.label)===governing.label;
      const status = c.exceeds ? 'fail' : (c.util<=1+1e-6 ? 'pass':'fail');
      const utilTxt = c.exceeds ? 'exceeds envelope' : fmt(100*c.util,0)+'%';
      const row = document.createElement('tr');
      if (isGov) row.className='governing';
      row.innerHTML =
        '<td class="txt">&nbsp;&nbsp;'+c.label+'</td>'+
        '<td>'+fmt(c.Pu,0)+'</td>'+
        '<td>'+fmt(c.Mu,1)+'</td>'+
        '<td>'+(c.xu!==null&&c.xu!==undefined?fmt(c.xu,0):'—')+'</td>'+
        '<td>'+utilTxt+'</td>'+
        '<td><span class="flag '+status+'">'+(status==='pass'?'WITHIN LIMIT':'FAILS CHECK')+'</span></td>';
      vbody.appendChild(row);
    });
  });

  document.getElementById('results').classList.remove('hidden');
  document.getElementById('results').scrollIntoView({behavior:'smooth'});
}

function drawChart(data){
  const {branchAc:branchA, branchBc:branchB, PuMaxCode:PuMax, combos} = data;
  const W = 760, H = 460, pad = {l:70,r:30,t:20,b:50};
  const allM = branchA.map(p=>p.Mu).concat(branchB.map(p=>p.Mu));
  const allP = branchA.map(p=>p.Pu).concat(branchB.map(p=>p.Pu));
  let mMax = Math.max(...allM.map(Math.abs))*1.15;
  let pMax = Math.max(...allP)*1.1;
  let pMin = Math.min(...allP)*1.1;
  if (mMax===0) mMax=1;
  const x = m => pad.l + (m + mMax)/(2*mMax)*(W-pad.l-pad.r);
  const y = p => H-pad.b - (p - pMin)/(pMax-pMin)*(H-pad.t-pad.b);

  function pathFor(branch){
    return branch.map((p,i)=> (i===0?'M':'L')+x(p.Mu).toFixed(1)+','+y(p.Pu).toFixed(1)).join(' ');
  }

  let svg = '<svg viewBox="0 0 '+W+' '+H+'" width="100%" style="max-width:'+W+'px;font-family:Roboto Mono,monospace;font-size:10.5px;">';
  // dotted gridlines (drawn first, behind everything)
  for (let i=-4;i<=4;i++){
    const mv = i*mMax/4;
    svg += '<line x1="'+x(mv).toFixed(1)+'" y1="'+pad.t+'" x2="'+x(mv).toFixed(1)+'" y2="'+(H-pad.b)+'" stroke="#D7E0E7" stroke-width="1" stroke-dasharray="1.5,3.5"/>';
  }
  for (let i=0;i<=4;i++){
    const pv = pMin + i*(pMax-pMin)/4;
    svg += '<line x1="'+pad.l+'" y1="'+y(pv).toFixed(1)+'" x2="'+(W-pad.r)+'" y2="'+y(pv).toFixed(1)+'" stroke="#D7E0E7" stroke-width="1" stroke-dasharray="1.5,3.5"/>';
  }
  svg += '<line x1="'+pad.l+'" y1="'+y(0)+'" x2="'+(W-pad.r)+'" y2="'+y(0)+'" stroke="#C9D6E0"/>';
  svg += '<line x1="'+x(0)+'" y1="'+pad.t+'" x2="'+x(0)+'" y2="'+(H-pad.b)+'" stroke="#C9D6E0"/>';
  svg += '<line x1="'+pad.l+'" y1="'+y(PuMax).toFixed(1)+'" x2="'+(W-pad.r)+'" y2="'+y(PuMax).toFixed(1)+'" stroke="#D68910" stroke-width="1.5" stroke-dasharray="5,4"/>';
  svg += '<text x="'+(W-pad.r)+'" y="'+(y(PuMax)-5)+'" text-anchor="end" fill="#D68910">Pu,max</text>';
  svg += '<path d="'+pathFor(branchA)+'" fill="none" stroke="#1B4F72" stroke-width="2.2"/>';
  svg += '<path d="'+pathFor(branchB)+'" fill="none" stroke="#5B8AAE" stroke-width="2.2"/>';
  svg += '<text x="'+(W/2)+'" y="'+(H-14)+'" text-anchor="middle" fill="#5B7182">Mu (kNm)</text>';
  svg += '<text x="18" y="'+(H/2)+'" text-anchor="middle" fill="#5B7182" transform="rotate(-90,18,'+(H/2)+')">Pu (kN)</text>';
  for (let i=-4;i<=4;i++){
    const mv = i*mMax/4;
    svg += '<text x="'+x(mv).toFixed(1)+'" y="'+(y(0)+16)+'" text-anchor="middle" fill="#8598a6">'+fmt(mv,0)+'</text>';
  }
  for (let i=0;i<=4;i++){
    const pv = pMin + i*(pMax-pMin)/4;
    svg += '<text x="'+(pad.l-8)+'" y="'+(y(pv)+3)+'" text-anchor="end" fill="#8598a6">'+fmt(pv,0)+'</text>';
  }

  combos.forEach(combo=>{
    combo.cases.forEach(c=>{
      const safe = !c.exceeds && c.util<=1+1e-6;
      const col = safe ? '#1E7B4D' : '#D68910';
      const cx = x(c.Mu), cy = y(c.Pu);
      svg += '<circle cx="'+cx.toFixed(1)+'" cy="'+cy.toFixed(1)+'" r="5" fill="'+col+'" stroke="#fff" stroke-width="1.3"/>';
    });
  });

  svg += '</svg>';
  document.getElementById('chartWrap').innerHTML = svg;
}
