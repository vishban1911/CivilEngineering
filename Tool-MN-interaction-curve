<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tool - M-N Interaction Curve (IS 456:2000)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bp-blue:#1B4F72;
    --bp-blue-light:#EAF1F6;
    --bp-amber:#D68910;
    --bp-amber-light:#FCF3E3;
    --bp-green:#1E7B4D;
    --bp-green-light:#E8F5EE;
    --bg:#F7F9FB;
    --line:#C9D6E0;
    --ink:#1C2B36;
    --ink-soft:#5B7182;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Inter',system-ui,sans-serif;
    color:var(--ink);
    background-color:var(--bg);
    background-image:
      linear-gradient(rgba(27,79,114,0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(27,79,114,0.055) 1px, transparent 1px);
    background-size:24px 24px;
    padding-bottom:60px;
  }
  .wrap{max-width:1180px;margin:0 auto;padding:0 20px;}
  header.titleblock{
    background:var(--bp-blue);
    color:#fff;
    padding:22px 0;
    border-bottom:6px solid var(--bp-amber);
    margin-bottom:22px;
  }
  header.titleblock .wrap{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px;}
  header.titleblock h1{margin:0;font-size:22px;font-weight:700;letter-spacing:0.2px;}
  header.titleblock .code-ref{
    font-family:'Roboto Mono',monospace;
    font-size:13px;
    background:rgba(255,255,255,0.14);
    padding:6px 12px;
    border:1px solid rgba(255,255,255,0.35);
    border-radius:2px;
  }
  header.titleblock .sub{font-size:12.5px;opacity:0.85;margin-top:2px;}

  .panel{
    background:#fff;
    border:1px solid var(--line);
    border-radius:3px;
    margin-bottom:18px;
    box-shadow:0 1px 2px rgba(27,79,114,0.06);
  }
  .panel > .panel-head{
    background:var(--bp-blue-light);
    border-bottom:1px solid var(--line);
    padding:10px 16px;
    font-weight:600;
    font-size:13.5px;
    color:var(--bp-blue);
    text-transform:uppercase;
    letter-spacing:0.4px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:8px;
  }
  .panel > .panel-body{padding:16px;}

  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;}
  @media (max-width:820px){.grid2,.grid3{grid-template-columns:1fr;}}

  label{
    display:block;
    font-size:12px;
    font-weight:600;
    color:var(--ink-soft);
    margin-bottom:4px;
    text-transform:uppercase;
    letter-spacing:0.3px;
  }
  .field{margin-bottom:12px;}
  .field .unit{font-weight:400;text-transform:none;color:#8598a6;}
  input[type=number], input[type=text], select{
    width:100%;
    font-family:'Roboto Mono',monospace;
    font-size:14px;
    padding:8px 9px;
    border:1px solid var(--line);
    border-radius:2px;
    background:#fff;
    color:var(--ink);
  }
  input[type=text]{font-family:'Inter',sans-serif;}
  input:focus, select:focus{outline:2px solid var(--bp-blue);outline-offset:0;}
  input:disabled{background:#EFF2F5;color:#9AAAB5;}

  .layer-box{
    border:1px dashed var(--line);
    border-radius:2px;
    padding:12px;
    margin-bottom:10px;
    background:#FBFDFE;
  }
  .layer-box.disabled{opacity:0.55;}
  .layer-box h4{margin:0;font-size:12.5px;color:var(--bp-blue);font-weight:700;display:flex;align-items:center;gap:8px;}
  .layer-box h4 input[type=checkbox]{width:auto;margin:0;}
  .layer-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:10px;}

  .face-title{
    font-weight:700;
    font-size:13.5px;
    color:var(--ink);
    margin:0 0 10px 0;
    padding-bottom:6px;
    border-bottom:2px solid var(--bp-blue);
  }

  table{width:100%;border-collapse:collapse;font-size:13px;}
  th{
    background:var(--bp-blue-light);
    color:var(--bp-blue);
    font-size:11.5px;
    text-transform:uppercase;
    letter-spacing:0.3px;
    text-align:left;
    padding:8px 8px;
    border:1px solid var(--line);
  }
  td{padding:6px 8px;border:1px solid var(--line);font-family:'Roboto Mono',monospace;vertical-align:middle;}
  td.txt{font-family:'Inter',sans-serif;}
  table input{padding:5px 6px;font-size:13px;}
  tr:nth-child(even) td{background:#FBFDFE;}
  tr.group-head td{
    background:var(--bp-blue);
    color:#fff;
    font-family:'Inter',sans-serif;
    font-weight:700;
    font-size:12.5px;
    text-transform:uppercase;
    letter-spacing:0.3px;
  }
  tr.governing td{background:var(--bp-amber-light) !important;}

  .btn{
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:13px;
    padding:9px 16px;
    border-radius:2px;
    border:1px solid var(--bp-blue);
    background:#fff;
    color:var(--bp-blue);
    cursor:pointer;
  }
  .btn:hover{background:var(--bp-blue-light);}
  .btn-primary{
    background:var(--bp-blue);
    color:#fff;
    font-size:15px;
    padding:13px 20px;
    width:100%;
    border:none;
  }
  .btn-primary:hover{background:#163f5c;}

  .flag{
    display:inline-block;
    font-family:'Inter',sans-serif;
    font-weight:700;
    font-size:11.5px;
    letter-spacing:0.3px;
    padding:4px 9px;
    border-radius:2px;
  }
  .flag.pass{background:var(--bp-green-light);color:var(--bp-green);border:1px solid var(--bp-green);}
  .flag.fail{background:var(--bp-amber-light);color:var(--bp-amber);border:1px solid var(--bp-amber);}

  .summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
  @media (max-width:820px){.summary-grid{grid-template-columns:1fr 1fr;}}
  .stat{
    border:1px solid var(--line);
    border-radius:2px;
    padding:12px;
    background:#FBFDFE;
  }
  .stat.highlight{background:var(--bp-amber-light);border-color:var(--bp-amber);}
  .stat .stat-label{font-size:11px;text-transform:uppercase;letter-spacing:0.3px;color:var(--ink-soft);font-weight:600;}
  .stat .stat-val{font-family:'Roboto Mono',monospace;font-size:19px;font-weight:700;color:var(--bp-blue);margin-top:4px;}
  .stat.highlight .stat-val{color:#8a5c07;}
  .stat .stat-sub{font-size:11px;color:var(--ink-soft);margin-top:2px;}

  .note{font-size:12.5px;color:var(--ink-soft);line-height:1.5;}
  .note ul{margin:6px 0 0 18px;padding:0;}
  .note li{margin-bottom:5px;}

  footer.disclaimer{
    max-width:1180px;
    margin:30px auto 0 auto;
    padding:16px 20px;
    border:1px solid var(--bp-amber);
    background:var(--bp-amber-light);
    border-radius:3px;
    font-size:12.5px;
    color:#6b4a08;
    line-height:1.55;
  }
  footer.disclaimer b{color:#5a3c06;}

  .hidden{display:none;}
  .chart-wrap{width:100%;overflow-x:auto;}
  .legend{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--ink-soft);margin-top:8px;}
  .legend span{display:inline-flex;align-items:center;gap:6px;}
  .swatch{width:14px;height:3px;display:inline-block;}
  .dot{width:10px;height:10px;border-radius:50%;display:inline-block;}

  .sketch-panel{
    border:1px solid var(--line);
    border-radius:2px;
    padding:12px;
    background:#FBFDFE;
  }
  .sketch-legend{display:flex;gap:16px;flex-wrap:wrap;font-size:11.5px;color:var(--ink-soft);margin-top:6px;}
  .sketch-legend span{display:inline-flex;align-items:center;gap:5px;}
  .bar-dot{width:11px;height:11px;border-radius:50%;display:inline-block;border:1.5px solid var(--bp-blue);}
  .bar-dot.solid{background:var(--bp-blue);}
  .bar-dot.hollow{background:#fff;}

  table.combo-table{margin:0;}
  table.combo-table td, table.combo-table th{padding:5px 8px;font-size:12.5px;}
  table.combo-table tr.combo-name-row td{
    background:var(--bp-blue);
    padding:6px 8px;
  }
  table.combo-table tr.combo-name-row input[type=text]{
    background:rgba(255,255,255,0.92);
    font-weight:600;
    max-width:320px;
  }
  table.combo-table tr.case-row td.txt{color:var(--ink-soft);font-size:12px;}
</style>
</head>
<body>

<header class="titleblock">
  <div class="wrap">
    <div>
      <h1>M-N Interaction Curve — Uniaxial Bending with Axial Load</h1>
      <div class="sub">Rectangular RC column / pier section &nbsp;|&nbsp; Strain-compatibility method</div>
    </div>
    <div class="code-ref">IS 456:2000 — Annex E &amp; Cl. 39</div>
  </div>
</header>

<div class="wrap">

  <div class="panel">
    <div class="panel-head">1. Section &amp; Materials</div>
    <div class="panel-body">
      <div class="grid3">
        <div class="field">
          <label>Width, b <span class="unit">(mm)</span></label>
          <input type="number" id="b" value="300" min="100" step="10" oninput="updateSketch()">
        </div>
        <div class="field">
          <label>Overall Depth, D <span class="unit">(mm)</span> — direction of bending</label>
          <input type="number" id="D" value="500" min="150" step="10" oninput="updateSketch()">
        </div>
        <div class="field">
          <label>&nbsp;</label>
          <div class="note">D is measured in the direction of the applied moment (top ↔ bottom faces below).</div>
        </div>
      </div>
      <div class="grid3">
        <div class="field">
          <label>Concrete grade, f<sub>ck</sub></label>
          <select id="fck">
            <option value="20">M20</option>
            <option value="25" selected>M25</option>
            <option value="30">M30</option>
            <option value="35">M35</option>
            <option value="40">M40</option>
            <option value="45">M45</option>
            <option value="50">M50</option>
          </select>
        </div>
        <div class="field">
          <label>Steel grade, f<sub>y</sub></label>
          <select id="fy">
            <option value="250">Fe 250 (mild steel)</option>
            <option value="415" selected>Fe 415</option>
            <option value="500">Fe 500</option>
            <option value="500d">Fe 500D</option>
            <option value="550">Fe 550</option>
          </select>
        </div>
        <div class="field">
          <label>&nbsp;</label>
          <div class="note">Design stress-strain curve for HYSD bars per IS 456 Fig. 23 / Annex E is used for Fe 415/500/500D/550. Fe 250 uses elastic–perfectly-plastic at 0.87f<sub>y</sub>.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">2. Reinforcement — up to 2 layers per face</div>
    <div class="panel-body">
      <div class="grid2">
        <div>
          <p class="face-title">TOP face (compression face for +Ve moment)</p>
          <div class="layer-box">
            <h4>Layer 1</h4>
            <div class="layer-grid">
              <div class="field"><label>Bar dia <span class="unit">(mm)</span></label><input type="number" id="t1dia" value="16" min="0" oninput="updateSketch()"></div>
              <div class="field"><label>No. of bars</label><input type="number" id="t1n" value="4" min="0" oninput="updateSketch()"></div>
              <div class="field"><label>Cover to centroid <span class="unit">(mm)</span></label><input type="number" id="t1cov" value="45" min="10" oninput="updateSketch()"></div>
            </div>
          </div>
          <div class="layer-box disabled" id="t2box">
            <h4><input type="checkbox" id="t2en" onchange="toggleLayer('t2')"> Include Layer 2</h4>
            <div class="layer-grid">
              <div class="field"><label>Bar dia <span class="unit">(mm)</span></label><input type="number" id="t2dia" value="16" min="0" disabled oninput="updateSketch()"></div>
              <div class="field"><label>No. of bars</label><input type="number" id="t2n" value="4" min="0" disabled oninput="updateSketch()"></div>
              <div class="field"><label>Cover to centroid <span class="unit">(mm)</span></label><input type="number" id="t2cov" value="85" min="10" disabled oninput="updateSketch()"></div>
            </div>
          </div>
        </div>
        <div>
          <p class="face-title">BOTTOM face (compression face for -Ve moment)</p>
          <div class="layer-box">
            <h4>Layer 1</h4>
            <div class="layer-grid">
              <div class="field"><label>Bar dia <span class="unit">(mm)</span></label><input type="number" id="b1dia" value="16" min="0" oninput="updateSketch()"></div>
              <div class="field"><label>No. of bars</label><input type="number" id="b1n" value="4" min="0" oninput="updateSketch()"></div>
              <div class="field"><label>Cover to centroid <span class="unit">(mm)</span></label><input type="number" id="b1cov" value="45" min="10" oninput="updateSketch()"></div>
            </div>
          </div>
          <div class="layer-box disabled" id="b2box">
            <h4><input type="checkbox" id="b2en" onchange="toggleLayer('b2')"> Include Layer 2</h4>
            <div class="layer-grid">
              <div class="field"><label>Bar dia <span class="unit">(mm)</span></label><input type="number" id="b2dia" value="16" min="0" disabled oninput="updateSketch()"></div>
              <div class="field"><label>No. of bars</label><input type="number" id="b2n" value="4" min="0" disabled oninput="updateSketch()"></div>
              <div class="field"><label>Cover to centroid <span class="unit">(mm)</span></label><input type="number" id="b2cov" value="85" min="10" disabled oninput="updateSketch()"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="note" id="steelSummary" style="margin-top:6px;"></div>

      <p class="face-title" style="margin-top:16px;">Section Sketch</p>
      <div class="sketch-panel">
        <div id="sectionSketch" class="chart-wrap"></div>
        <div class="note">Schematic cross-section — bar count, diameter and vertical cover are to scale; lateral bar spacing is shown evenly distributed and is indicative only, not a detailing drawing.</div>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">3. Load Combinations</div>
    <div class="panel-body">
      <div class="field" style="max-width:360px;">
        <label>Number of load combinations</label>
        <select id="numCombos" onchange="generateCombos()">
          <option value="envelope">Envelope forces only (1 set)</option>
          <option value="1">1 load combination</option>
          <option value="2">2 load combinations</option>
          <option value="3">3 load combinations</option>
          <option value="4">4 load combinations</option>
          <option value="5">5 load combinations</option>
          <option value="6">6 load combinations</option>
          <option value="8">8 load combinations</option>
          <option value="10">10 load combinations</option>
        </select>
      </div>
      <div class="note" style="margin-bottom:10px;">Each combination has 4 governing cases: Max M (corr. N), Max N (corr. M), Min N (corr. M), Min M (corr. N). Leave a row blank to skip it. Sign convention: P<sub>u</sub> positive = compression; M<sub>u</sub> positive bends the section so the <b>top face</b> is in compression (use negative M<sub>u</sub> for the reverse sense).</div>
      <div id="combosContainer">
        <table class="combo-table">
          <thead><tr><th style="width:40%;">Combination / Case</th><th style="width:30%;">P<sub>u</sub> (kN)</th><th style="width:30%;">M<sub>u</sub> (kNm)</th></tr></thead>
          <tbody id="combosBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <button class="btn-primary" onclick="runCalc()">Calculate Interaction Curve &amp; Check Load Cases</button>

  <div id="results" class="hidden">

    <div class="panel" style="margin-top:22px;">
      <div class="panel-head">4. Section Capacity Summary</div>
      <div class="panel-body">
        <div class="summary-grid" id="summaryGrid"></div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">5. P-M Interaction Diagram</div>
      <div class="panel-body">
        <div class="chart-wrap" id="chartWrap"></div>
        <div class="legend">
          <span><span class="swatch" style="background:#1B4F72;"></span> Capacity curve (+M, top compression)</span>
          <span><span class="swatch" style="background:#5B8AAE;"></span> Capacity curve (−M, bottom compression)</span>
          <span><span class="swatch" style="background:#D68910;border-top:2px dashed #D68910;height:0;"></span> P<sub>u,max</sub> cap (Cl 39.3)</span>
          <span><span class="dot" style="background:#1E7B4D;"></span> Load case — within envelope</span>
          <span><span class="dot" style="background:#D68910;"></span> Load case — exceeds envelope</span>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">6. Verification of Load Combinations</div>
      <div class="panel-body">
        <table>
          <thead>
            <tr>
              <th>Load combination / case</th>
              <th>P<sub>u</sub> (kN)</th>
              <th>M<sub>u</sub> applied (kNm)</th>
              <th>x<sub>u</sub> on envelope (mm)</th>
              <th>Combined P-M utilisation</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="verifyBody"></tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">7. Method &amp; Assumptions</div>
      <div class="panel-body note">
        <ul>
          <li>Strain compatibility per IS 456:2000 Annex E: max. concrete strain 0.0035 at the highly compressed edge when the neutral axis lies within the section (x<sub>u</sub> ≤ D); for x<sub>u</sub> &gt; D the strain profile passes through 0.002 at 3D/7 from the highly compressed edge.</li>
          <li>Concrete stress block: parabolic-rectangular per Cl 38.1 (design stress 0.447 f<sub>ck</sub>). Concrete tensile strength is neglected.</li>
          <li>Reinforcement stress-strain: idealised design curve per IS 456 Fig. 23 for HYSD bars (Fe 415/500/500D/550); elastic-perfectly-plastic at 0.87f<sub>y</sub> for Fe 250. Displaced concrete area at compression bar locations is deducted.</li>
          <li>Curve generated by sweeping the neutral axis depth x<sub>u</sub> from a shallow depth (tension-controlled) through x<sub>u</sub> → ∞ (pure axial compression), separately for bending in the +M and −M sense (relevant when top/bottom reinforcement differs). Axial capacity is capped at P<sub>u,max</sub> = 0.4 f<sub>ck</sub> A<sub>c</sub> + 0.67 f<sub>y</sub> A<sub>sc</sub> per Cl 39.3.</li>
          <li><b>Combined P-M utilisation</b> is computed radially: for each applied (P<sub>u</sub>, M<sub>u</sub>) point, both P and M are scaled together along the same ratio until the pair lands exactly on the capacity envelope. Utilisation = applied / scaled-capacity. This reflects the true combined effect of axial load and moment acting together, rather than checking moment capacity alone at the applied P<sub>u</sub>.</li>
          <li><b>Not covered by this tool</b> — verify separately: minimum eccentricity per Cl 25.4 (e<sub>min</sub> = unsupported length/500 + D/30, ≥ 20 mm); biaxial bending interaction per Cl 39.6; slenderness / additional moments for slender columns per Cl 39.7; shear, confinement and detailing (Cl 26, IS 13920 for ductile detailing); and section shapes other than rectangular.</li>
          <li>This is a uniaxial P-M check about the axis defined by D only. For a real column, both principal directions should be checked.</li>
        </ul>
      </div>
    </div>

  </div>

</div>

<footer class="disclaimer">
  <b>Disclaimer:</b> This tool is provided for preliminary and educational use only. Results should be independently verified by a qualified engineer before use in design or construction. This is not a substitute for professional judgment or compliance verification against the applicable project-specific code requirements.
</footer>

<script>
const Es = 200000;
const CASE_LABELS = ['Max M, corr. N','Max N, corr. M','Min N, corr. M','Min M, corr. N'];

function toggleLayer(prefix){
  const en = document.getElementById(prefix+'en').checked;
  const box = document.getElementById(prefix+'box');
  box.classList.toggle('disabled', !en);
  ['dia','n','cov'].forEach(f=>{
    document.getElementById(prefix+f).disabled = !en;
  });
  updateSketch();
}

function val(id){ return parseFloat(document.getElementById(id).value)||0; }

function updateSketch(){
  const b = val('b'), D = val('D');
  if (!b || !D){ document.getElementById('sectionSketch').innerHTML=''; return; }
  const top = [
    {dia:val('t1dia'), n:val('t1n'), cov:val('t1cov'), layer:1},
    {dia:val('t2dia'), n:val('t2n'), cov:val('t2cov'), layer:2, en:document.getElementById('t2en').checked}
  ].filter(l=>l.n>0 && l.dia>0 && (l.layer===1 || l.en));
  const bottom = [
    {dia:val('b1dia'), n:val('b1n'), cov:val('b1cov'), layer:1},
    {dia:val('b2dia'), n:val('b2n'), cov:val('b2cov'), layer:2, en:document.getElementById('b2en').checked}
  ].filter(l=>l.n>0 && l.dia>0 && (l.layer===1 || l.en));

  const VBW=460, VBH=380, margin=64;
  const availW = VBW-2*margin, availH = VBH-2*margin-20;
  const scale = Math.min(availW/b, availH/D);
  const rectW = b*scale, rectH = D*scale;
  const ox = (VBW-rectW)/2, oy = margin;

  let svg = '<svg viewBox="0 0 '+VBW+' '+VBH+'" width="100%" style="max-width:420px;font-family:Roboto Mono,monospace;font-size:11px;">';
  // concrete outline
  svg += '<rect x="'+ox.toFixed(1)+'" y="'+oy.toFixed(1)+'" width="'+rectW.toFixed(1)+'" height="'+rectH.toFixed(1)+'" fill="#EAF1F6" stroke="#1B4F72" stroke-width="2"/>';

  function drawLayerRow(layers, faceTop){
    layers.forEach(layer=>{
      const yMm = faceTop ? layer.cov : (D-layer.cov);
      const ySvg = oy + yMm*scale;
      const r = Math.max(layer.dia*scale/2, 2.6);
      const inset = Math.min(Math.max(layer.cov*scale, r+4), rectW/2-4);
      const n = layer.n;
      for (let i=0;i<n;i++){
        const xSvg = n===1 ? ox+rectW/2 : ox+inset + i*(rectW-2*inset)/(n-1);
        const solid = layer.layer===1;
        svg += '<circle cx="'+xSvg.toFixed(1)+'" cy="'+ySvg.toFixed(1)+'" r="'+r.toFixed(1)+'" fill="'+(solid?'#1B4F72':'#fff')+'" stroke="#1B4F72" stroke-width="1.4"/>';
      }
      const lbl = layer.n+'-\u00D8'+layer.dia+' @ '+layer.cov+'mm cov';
      const labelY = faceTop ? ySvg-r-6 : ySvg+r+13;
      svg += '<text x="'+(ox+rectW+8)+'" y="'+(faceTop? oy+ (layer.layer===1?18:34) : oy+rectH- (layer.layer===1?6:22) )+'" fill="#5B7182" font-size="10.5">'+(faceTop?'T':'B')+layer.layer+': '+lbl+'</text>';
    });
  }
  drawLayerRow(top, true);
  drawLayerRow(bottom, false);

  // dimension line for b (below section)
  const dimY = oy+rectH+28;
  svg += '<line x1="'+ox+'" y1="'+dimY+'" x2="'+(ox+rectW)+'" y2="'+dimY+'" stroke="#8598a6" stroke-width="1"/>';
  svg += '<line x1="'+ox+'" y1="'+(dimY-5)+'" x2="'+ox+'" y2="'+(dimY+5)+'" stroke="#8598a6"/>';
  svg += '<line x1="'+(ox+rectW)+'" y1="'+(dimY-5)+'" x2="'+(ox+rectW)+'" y2="'+(dimY+5)+'" stroke="#8598a6"/>';
  svg += '<text x="'+(ox+rectW/2)+'" y="'+(dimY+16)+'" text-anchor="middle" fill="#5B7182">b = '+b+' mm</text>';

  // dimension line for D (left of section)
  const dimX = ox-26;
  svg += '<line x1="'+dimX+'" y1="'+oy+'" x2="'+dimX+'" y2="'+(oy+rectH)+'" stroke="#8598a6" stroke-width="1"/>';
  svg += '<line x1="'+(dimX-5)+'" y1="'+oy+'" x2="'+(dimX+5)+'" y2="'+oy+'" stroke="#8598a6"/>';
  svg += '<line x1="'+(dimX-5)+'" y1="'+(oy+rectH)+'" x2="'+(dimX+5)+'" y2="'+(oy+rectH)+'" stroke="#8598a6"/>';
  svg += '<text x="'+(dimX-8)+'" y="'+(oy+rectH/2)+'" text-anchor="middle" fill="#5B7182" transform="rotate(-90,'+(dimX-8)+','+(oy+rectH/2)+')">D = '+D+' mm</text>';

  svg += '<text x="'+(ox+rectW/2)+'" y="'+(oy-10)+'" text-anchor="middle" fill="#1B4F72" font-weight="700">TOP</text>';
  svg += '<text x="'+(ox+rectW/2)+'" y="'+(oy+rectH+50)+'" text-anchor="middle" fill="#1B4F72" font-weight="700">BOTTOM</text>';

  svg += '</svg>';
  document.getElementById('sectionSketch').innerHTML = svg +
    '<div class="sketch-legend"><span><span class="bar-dot solid"></span> Layer 1</span><span><span class="bar-dot hollow"></span> Layer 2</span></div>';
}

function generateCombos(){
  const sel = document.getElementById('numCombos').value;
  const n = sel==='envelope' ? 1 : parseInt(sel);
  const tbody = document.getElementById('combosBody');
  tbody.innerHTML = '';
